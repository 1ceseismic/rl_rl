+void GGL::PPOLearner::InferActionsGraphed(torch::Tensor obs, torch::Tensor actionMasks,
+	torch::Tensor* outActions, torch::Tensor* outLogProbs) {
+
+	if (!inferGraph.captured || inferGraph.obs.size(0) != obs.size(0)) {
+		inferGraph.obs = torch::zeros_like(obs);
+		inferGraph.masks = torch::ones_like(actionMasks);
+
+		{
+			auto stream = c10::cuda::getStreamFromPool();
+			c10::cuda::CUDAStreamGuard guard(stream);
+
+			for (int i = 0; i < 3; i++)
+				InferActionsFromModels(models, inferGraph.obs, inferGraph.masks,
+					config.deterministic, config.policyTemperature, config.useHalfPrecision,
+					&inferGraph.actions, &inferGraph.logProbs);
+			stream.synchronize();
+
+			inferGraph.graph.register_generator_state(at::cuda::detail::getDefaultCUDAGenerator());
+			inferGraph.graph.capture_begin();
+			InferActionsFromModels(models, inferGraph.obs, inferGraph.masks,
+				config.deterministic, config.policyTemperature, config.useHalfPrecision,
+				&inferGraph.actions, &inferGraph.logProbs);
+			inferGraph.graph.capture_end();
+		}
+		inferGraph.captured = true;
+	}
+
+	inferGraph.obs.copy_(obs, true);
+	inferGraph.masks.copy_(actionMasks, true);
+	inferGraph.graph.replay();
+
+	if (outActions)
+		*outActions = inferGraph.actions;
+	if (outLogProbs)
+		*outLogProbs = inferGraph.logProbs;
+}
