#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
usage: scripts/go [opts] [build|run]
  -w            watch in rlviser
  -s SPEED      render speed
  -c            clean build
  -R            delete all checkpoints
  -n N          num games
  -M            disable wandb
  -y            skip picker
  --run-name N  use run name
EOF
}

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build-ggl"
BINARY="$BUILD_DIR/rl_rl_ggl"
CKPT_ROOT="$BUILD_DIR/checkpoints_ggl"

TORCH_PATH="${TORCH_PATH:-$ROOT/.venv/lib/python3.12/site-packages/torch}"
MESH_DIR="${GGL_MESH_DIR:-$ROOT/collision_meshes}"
NUM_GAMES="${GGL_NUM_GAMES:-36}"
RUN_NAME="${GGL_RUN_NAME:-}"
NO_METRICS=0
RENDER=0
RENDER_SPEED=""
CLEAN=0
RESET=0
NONINTERACTIVE=0
ACTION=both

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clean) CLEAN=1; shift ;;
        -R|--reset) RESET=1; shift ;;
        -w|--render|--watch) RENDER=1; NUM_GAMES=${GGL_NUM_GAMES:-2}; shift ;;
        -s|--speed) RENDER_SPEED="$2"; shift 2 ;;
        -n|--num-games) NUM_GAMES="$2"; shift 2 ;;
        -m|--metrics) NO_METRICS=0; shift ;;
        -M|--no-metrics) NO_METRICS=1; shift ;;
        -y|--yes) NONINTERACTIVE=1; shift ;;
        --run-name) RUN_NAME="$2"; shift 2 ;;
        build) ACTION=build; shift ;;
        run) ACTION=run; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown arg: $1"; exit 2 ;;
    esac
done

if [[ "$RESET" == "1" ]]; then
    echo "[go] reset ALL checkpoints: $CKPT_ROOT"
    rm -rf "$CKPT_ROOT"
fi

need_build() {
    [[ ! -x "$BINARY" ]] && return 0
    local newest
    newest=$(find "$ROOT/ggl" "$ROOT/CMakeLists.txt" "$ROOT/scripts/build_ggl.sh" \
        -type f \( -name '*.cpp' -o -name '*.h' -o -name 'CMakeLists.txt' -o -name 'build_ggl.sh' \) \
        -newer "$BINARY" -print -quit 2>/dev/null)
    [[ -n "$newest" ]]
}

if [[ "$ACTION" != "run" ]]; then
    if [[ "$CLEAN" == "1" ]]; then
        echo "[go] clean build"
        rm -rf "$BUILD_DIR"
    fi
    mkdir -p "$BUILD_DIR"
    if [[ "$CLEAN" == "1" ]] || need_build; then
        echo "[go] building (log: $BUILD_DIR/.go_build.log)"
        if ! TORCH_PATH="$TORCH_PATH" "$ROOT/scripts/build_ggl.sh" >"$BUILD_DIR/.go_build.log" 2>&1; then
            echo "[go] build failed. last 40 lines:"
            tail -40 "$BUILD_DIR/.go_build.log"
            exit 1
        fi
        echo "[go] built: $BINARY"
    fi
fi

if [[ "$ACTION" == "build" ]]; then
    exit 0
fi

if [[ ! -x "$BINARY" ]]; then
    echo "[go] binary missing. run: scripts/go build"
    exit 1
fi

if [[ -z "$RUN_NAME" && "$NONINTERACTIVE" == "0" && "$ACTION" != "run" && -t 0 ]]; then
    PICKER_MODE="--train"
    [[ "$RENDER" == "1" ]] && PICKER_MODE="--watch"
    PICKER_OUT=$("$ROOT/scripts/ckpt.py" --root "$CKPT_ROOT" "$PICKER_MODE") || {
        echo "[go] picker aborted."; exit 1
    }
    eval "$PICKER_OUT"
fi

RUN_NAME="${RUN_NAME:-default}"

declare -a ENV_VARS=(
    "GGL_MESH_DIR=$MESH_DIR"
    "GGL_NUM_GAMES=$NUM_GAMES"
    "GGL_RUN_NAME=$RUN_NAME"
    "PATH=$ROOT:${PATH:-}"
)
[[ "$NO_METRICS" == "1" ]] && ENV_VARS+=("GGL_NO_METRICS=1")
if [[ "$RENDER" == "1" ]]; then
    ENV_VARS+=("GGL_RENDER=1")
    ENV_VARS+=("GGL_RENDER_SPEED=${RENDER_SPEED:-${GGL_RENDER_SPEED:-5.0}}")
elif [[ -n "$RENDER_SPEED" ]]; then
    ENV_VARS+=("GGL_RENDER_SPEED=$RENDER_SPEED")
fi

# embedded python uses venv
PY_EXE="${GGL_PYTHON:-$ROOT/.venv/bin/python}"
if [[ -x "$PY_EXE" ]]; then
    PY_HOME=$("$PY_EXE" -c 'import sys; print(sys.base_prefix)')
    PY_SITE=$("$PY_EXE" -c 'import site; print(site.getsitepackages()[0])')
    ENV_VARS+=("PYTHONHOME=$PY_HOME" "PYTHONPATH=$PY_SITE")
fi

ENV_VARS+=("WANDB_ENTITY=${WANDB_ENTITY:-rl_rlbot}")

echo "[go] running with: ${ENV_VARS[*]}"
cd "$BUILD_DIR"
exec env "${ENV_VARS[@]}" "$BINARY"
